{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only paid-retry preview; it cannot authorize provider egress.",
  "properties": {
    "mini_retry_units": {
      "minimum": 0,
      "title": "Mini Retry Units",
      "type": "integer"
    },
    "parent_candidate_id": {
      "pattern": "^autocand_[0-9a-f]{64}$",
      "title": "Parent Candidate Id",
      "type": "string"
    },
    "parent_candidate_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parent Candidate Sha256",
      "type": "string"
    },
    "parent_mini_results_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parent Mini Results Sha256",
      "type": "string"
    },
    "parent_strong_results_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Strong Results Sha256"
    },
    "parent_translation_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parent Translation Sha256",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^autorecoveryplan_[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "provider_egress_allowed": {
      "const": false,
      "default": false,
      "title": "Provider Egress Allowed",
      "type": "boolean"
    },
    "retry_http_statuses": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Retry Http Statuses",
      "type": "array"
    },
    "schema_version": {
      "const": "automation-recovery-plan-0.1.0",
      "default": "automation-recovery-plan-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strong_retry_units": {
      "minimum": 0,
      "title": "Strong Retry Units",
      "type": "integer"
    },
    "translation_retry_episodes": {
      "minimum": 0,
      "title": "Translation Retry Episodes",
      "type": "integer"
    }
  },
  "required": [
    "plan_id",
    "parent_candidate_id",
    "retry_http_statuses",
    "parent_candidate_sha256",
    "parent_translation_sha256",
    "parent_mini_results_sha256",
    "parent_strong_results_sha256",
    "translation_retry_episodes",
    "mini_retry_units",
    "strong_retry_units"
  ],
  "title": "AutomationRecoveryPlan",
  "type": "object"
}
