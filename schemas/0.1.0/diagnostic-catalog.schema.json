{
  "$defs": {
    "CatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "meaning": {
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage",
        "severity",
        "retryable",
        "meaning"
      ],
      "title": "CatalogEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "const": "0.1.0",
      "title": "Catalog Version",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "schema_version": {
      "const": "diagnostic-catalog-0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "entries"
  ],
  "title": "DiagnosticCatalog",
  "type": "object"
}
