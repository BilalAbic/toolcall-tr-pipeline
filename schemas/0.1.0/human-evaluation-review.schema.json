{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit human sign-off record; this is the sole gold-eligibility authority.",
  "properties": {
    "decision": {
      "enum": [
        "accept_for_gold",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "review_id": {
      "pattern": "^humanreview_[0-9a-f]{64}$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_finding_ids": {
      "items": {
        "pattern": "^mqm_[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Reviewed Finding Ids",
      "type": "array"
    },
    "reviewer_authority": {
      "const": "human",
      "title": "Reviewer Authority",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "human-evaluation-review-0.1.0",
      "default": "human-evaluation-review-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict_id": {
      "pattern": "^evalverdict_[0-9a-f]{64}$",
      "title": "Verdict Id",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "verdict_id",
    "reviewer_authority",
    "reviewer_id",
    "decision",
    "reviewed_finding_ids",
    "rationale"
  ],
  "title": "HumanEvaluationReview",
  "type": "object"
}
