{
  "$defs": {
    "EvaluationUnit": {
      "additionalProperties": false,
      "description": "One immutable source/target leaf that may be evaluated once per run.",
      "properties": {
        "episode_id": {
          "pattern": "^ep_[0-9a-f]{64}$",
          "title": "Episode Id",
          "type": "string"
        },
        "path": {
          "pattern": "^(?:/(?:[^/~]|~[01])*)*$",
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "evaluation-unit-0.1.0",
          "default": "evaluation-unit-0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^seg_[0-9a-f]{64}$",
          "title": "Segment Id",
          "type": "string"
        },
        "source_text_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Text Sha256",
          "type": "string"
        },
        "target_text_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Text Sha256",
          "type": "string"
        },
        "unit_id": {
          "pattern": "^evalunit_[0-9a-f]{64}$",
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "episode_id",
        "segment_id",
        "path",
        "source_text_sha256",
        "target_text_sha256"
      ],
      "title": "EvaluationUnit",
      "type": "object"
    },
    "SegmentPathEvidence": {
      "additionalProperties": false,
      "description": "Localized, bidirectional evidence for exactly one evaluation leaf.",
      "properties": {
        "path": {
          "pattern": "^(?:/(?:[^/~]|~[01])*)*$",
          "title": "Path",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^seg_[0-9a-f]{64}$",
          "title": "Segment Id",
          "type": "string"
        },
        "source_excerpt": {
          "minLength": 1,
          "title": "Source Excerpt",
          "type": "string"
        },
        "target_excerpt": {
          "minLength": 1,
          "title": "Target Excerpt",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "path",
        "source_excerpt",
        "target_excerpt"
      ],
      "title": "SegmentPathEvidence",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One strict, full-leaf source/target pair prepared for one judge role.\n\n``SegmentPathEvidence`` names its texts \"excerpts\" for generic evaluation\nuse.  The operational runner deliberately strengthens that contract: both\nvalues must be the *complete* leaf whose hashes are in ``evaluation_unit``.\nThis prevents an operator from silently pairing evidence with a different\nimmutable evaluation unit.",
  "properties": {
    "evaluation_unit": {
      "$ref": "#/$defs/EvaluationUnit"
    },
    "evidence": {
      "$ref": "#/$defs/SegmentPathEvidence"
    },
    "input_id": {
      "pattern": "^liveevalinput_[0-9a-f]{64}$",
      "title": "Input Id",
      "type": "string"
    },
    "schema_version": {
      "const": "live-evaluation-input-0.1.0",
      "default": "live-evaluation-input-0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "input_id",
    "evaluation_unit",
    "evidence"
  ],
  "title": "LiveEvaluationInput",
  "type": "object"
}
