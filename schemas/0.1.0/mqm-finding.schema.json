{
  "$defs": {
    "MqmCategory": {
      "enum": [
        "accuracy.mistranslation",
        "accuracy.omission",
        "accuracy.addition",
        "accuracy.untranslated",
        "terminology",
        "fluency.grammar",
        "fluency.spelling",
        "fluency.punctuation",
        "locale_convention",
        "style.register",
        "tool_semantics",
        "protected_content",
        "research_provenance"
      ],
      "type": "string"
    },
    "MqmSeverity": {
      "enum": [
        "minor",
        "major",
        "critical"
      ],
      "type": "string"
    },
    "SegmentPathEvidence": {
      "additionalProperties": false,
      "description": "Localized, bidirectional evidence for exactly one evaluation leaf.",
      "properties": {
        "path": {
          "pattern": "^(?:/(?:[^/~]|~[01])*)*$",
          "title": "Path",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^seg_[0-9a-f]{64}$",
          "title": "Segment Id",
          "type": "string"
        },
        "source_excerpt": {
          "minLength": 1,
          "title": "Source Excerpt",
          "type": "string"
        },
        "target_excerpt": {
          "minLength": 1,
          "title": "Target Excerpt",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "path",
        "source_excerpt",
        "target_excerpt"
      ],
      "title": "SegmentPathEvidence",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One atomic MQM-style issue; compound findings must be split by callers.",
  "properties": {
    "category": {
      "$ref": "#/$defs/MqmCategory"
    },
    "evidence": {
      "$ref": "#/$defs/SegmentPathEvidence"
    },
    "finding_id": {
      "pattern": "^mqm_[0-9a-f]{64}$",
      "title": "Finding Id",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "const": "mqm-finding-0.1.0",
      "default": "mqm-finding-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/MqmSeverity"
    }
  },
  "required": [
    "finding_id",
    "category",
    "severity",
    "evidence",
    "rationale"
  ],
  "title": "MqmFinding",
  "type": "object"
}
