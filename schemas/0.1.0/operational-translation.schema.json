{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Terminal local receipt for a bounded batch that cannot promote data.",
  "properties": {
    "batch_id": {
      "pattern": "^trbatch_[0-9a-f]{64}$",
      "title": "Batch Id",
      "type": "string"
    },
    "field_policy_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Field Policy Sha256",
      "type": "string"
    },
    "input_file_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input File Sha256",
      "type": "string"
    },
    "no_translatable_records": {
      "minimum": 0,
      "title": "No Translatable Records",
      "type": "integer"
    },
    "promotion": {
      "const": "not_eligible",
      "default": "not_eligible",
      "title": "Promotion",
      "type": "string"
    },
    "prompt_id": {
      "pattern": "^prompt_[0-9a-f]{64}$",
      "title": "Prompt Id",
      "type": "string"
    },
    "provider_attempts": {
      "minimum": 0,
      "title": "Provider Attempts",
      "type": "integer"
    },
    "research_required_records": {
      "minimum": 0,
      "title": "Research Required Records",
      "type": "integer"
    },
    "result_manifest_id": {
      "pattern": "^manifest_[0-9a-f]{64}$",
      "title": "Result Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": "operational-translation-0.1.0",
      "default": "operational-translation-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_records": {
      "minimum": 0,
      "title": "Source Records",
      "type": "integer"
    },
    "translated_records": {
      "minimum": 0,
      "title": "Translated Records",
      "type": "integer"
    }
  },
  "required": [
    "batch_id",
    "input_file_sha256",
    "field_policy_sha256",
    "prompt_id",
    "source_records",
    "translated_records",
    "research_required_records",
    "no_translatable_records",
    "provider_attempts",
    "result_manifest_id"
  ],
  "title": "OperationalTranslationReport",
  "type": "object"
}
