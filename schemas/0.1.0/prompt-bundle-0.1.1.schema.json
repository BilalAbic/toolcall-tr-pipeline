{
  "$defs": {
    "PromptLayer": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "name": {
          "enum": [
            "core_contract",
            "field_policy",
            "fidelity_contract",
            "protected_span_contract",
            "terminology_protocol",
            "output_contract",
            "contrastive_examples"
          ],
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "content",
        "content_sha256"
      ],
      "title": "PromptLayer",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fixed-order, content-addressed system-prompt layers for a future adapter.",
  "properties": {
    "layers": {
      "items": {
        "$ref": "#/$defs/PromptLayer"
      },
      "title": "Layers",
      "type": "array"
    },
    "output_schema_version": {
      "const": "translation-response-0.1.0",
      "title": "Output Schema Version",
      "type": "string"
    },
    "promotion_status": {
      "enum": [
        "candidate",
        "validated",
        "retired"
      ],
      "title": "Promotion Status",
      "type": "string"
    },
    "prompt_id": {
      "pattern": "^prompt_[0-9a-f]{64}$",
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "schema_version": {
      "const": "prompt-bundle-0.1.1",
      "default": "prompt-bundle-0.1.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "prompt_id",
    "prompt_version",
    "promotion_status",
    "output_schema_version",
    "layers"
  ],
  "title": "PromptBundle",
  "type": "object"
}
