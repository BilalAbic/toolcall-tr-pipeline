{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One occurrence-specific sentinel already substituted into a source segment.",
  "properties": {
    "occurrence": {
      "exclusiveMinimum": 0,
      "title": "Occurrence",
      "type": "integer"
    },
    "token": {
      "pattern": "^⟪S[1-9][0-9]*_P[1-9][0-9]*⟫$",
      "title": "Token",
      "type": "string"
    }
  },
  "required": [
    "token",
    "occurrence"
  ],
  "title": "ProtectedToken",
  "type": "object"
}
