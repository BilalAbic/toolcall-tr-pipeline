{
  "$defs": {
    "CharacterRange": {
      "additionalProperties": false,
      "description": "A half-open Python Unicode code-point range in the rendered text.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CharacterRange",
      "type": "object"
    },
    "TargetPayloadRange": {
      "additionalProperties": false,
      "description": "One renderer-declared span containing the final assistant payload.",
      "properties": {
        "assistant_message_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Assistant Message Sha256",
          "type": "string"
        },
        "character_range": {
          "$ref": "#/$defs/CharacterRange"
        },
        "rendered_payload_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rendered Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "character_range",
        "rendered_payload_sha256",
        "assistant_message_sha256"
      ],
      "title": "TargetPayloadRange",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Verified, content-addressed rendering before labels are attached.",
  "properties": {
    "episode_id": {
      "pattern": "^ep_[0-9a-f]{64}$",
      "title": "Episode Id",
      "type": "string"
    },
    "render_config_id": {
      "pattern": "^rendercfg_[0-9a-f]{64}$",
      "title": "Render Config Id",
      "type": "string"
    },
    "render_id": {
      "pattern": "^render_[0-9a-f]{64}$",
      "title": "Render Id",
      "type": "string"
    },
    "rendered_text": {
      "title": "Rendered Text",
      "type": "string"
    },
    "rendered_text_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rendered Text Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "render-artifact-0.1.0",
      "default": "render-artifact-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_payload_ranges": {
      "items": {
        "$ref": "#/$defs/TargetPayloadRange"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Target Payload Ranges",
      "type": "array"
    },
    "technical_structure_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Technical Structure Sha256",
      "type": "string"
    },
    "token_count": {
      "exclusiveMinimum": 0,
      "title": "Token Count",
      "type": "integer"
    },
    "variant_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Variant Id",
      "type": "string"
    }
  },
  "required": [
    "render_id",
    "render_config_id",
    "episode_id",
    "variant_id",
    "technical_structure_sha256",
    "rendered_text",
    "rendered_text_sha256",
    "target_payload_ranges",
    "token_count"
  ],
  "title": "RenderArtifact",
  "type": "object"
}
