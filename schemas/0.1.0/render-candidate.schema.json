{
  "$defs": {
    "CanonicalTool": {
      "additionalProperties": false,
      "properties": {
        "documentation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Documentation Hash",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/ToolFunction"
        },
        "normalizer_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Normalizer Version",
          "type": "string"
        },
        "raw_schema_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Schema Hash",
          "type": "string"
        },
        "semantic_schema_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Semantic Schema Hash",
          "type": "string"
        },
        "tool_id": {
          "pattern": "^tool_[0-9a-f]{64}$",
          "title": "Tool Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "raw_schema_hash",
        "semantic_schema_hash",
        "documentation_hash",
        "function"
      ],
      "title": "CanonicalTool",
      "type": "object"
    },
    "CharacterRange": {
      "additionalProperties": false,
      "description": "A half-open Python Unicode code-point range in the rendered text.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CharacterRange",
      "type": "object"
    },
    "FunctionCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "FunctionCall",
      "type": "object"
    },
    "ImageRef": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "minimum": 0,
          "title": "Anchor",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mime_type": {
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "uri",
        "mime_type",
        "sha256",
        "width",
        "height",
        "anchor"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content"
        },
        "images": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ImageRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Images"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "reasoning_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Content"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Thinking"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool Calls"
        }
      },
      "required": [
        "role",
        "content",
        "reasoning_content",
        "thinking",
        "tool_calls",
        "images",
        "name",
        "tool_call_id"
      ],
      "title": "Message",
      "type": "object"
    },
    "Role": {
      "enum": [
        "system",
        "developer",
        "user",
        "assistant",
        "tool"
      ],
      "title": "Role",
      "type": "string"
    },
    "TargetPayloadRange": {
      "additionalProperties": false,
      "description": "One renderer-declared span containing the final assistant payload.",
      "properties": {
        "assistant_message_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Assistant Message Sha256",
          "type": "string"
        },
        "character_range": {
          "$ref": "#/$defs/CharacterRange"
        },
        "rendered_payload_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rendered Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "character_range",
        "rendered_payload_sha256",
        "assistant_message_sha256"
      ],
      "title": "TargetPayloadRange",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "$ref": "#/$defs/FunctionCall"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "function"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolFunction": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "strict": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Strict"
        }
      },
      "required": [
        "name",
        "description",
        "parameters",
        "strict"
      ],
      "title": "ToolFunction",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Untrusted, in-memory response supplied by an injected chat renderer.\n\n``rendered_conversation`` and ``rendered_tools`` are deliberate echoes of\nthe technical input used by the renderer.  They allow the host to reject a\nrenderer that drops, reorders, or rewrites tool-call structure before any\nloss labels are emitted.",
  "properties": {
    "episode_id": {
      "pattern": "^ep_[0-9a-f]{64}$",
      "title": "Episode Id",
      "type": "string"
    },
    "render_config_id": {
      "pattern": "^rendercfg_[0-9a-f]{64}$",
      "title": "Render Config Id",
      "type": "string"
    },
    "rendered_conversation": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "minItems": 1,
      "title": "Rendered Conversation",
      "type": "array"
    },
    "rendered_text": {
      "title": "Rendered Text",
      "type": "string"
    },
    "rendered_tools": {
      "items": {
        "$ref": "#/$defs/CanonicalTool"
      },
      "title": "Rendered Tools",
      "type": "array"
    },
    "schema_version": {
      "const": "render-candidate-0.1.0",
      "default": "render-candidate-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_message_index": {
      "minimum": 0,
      "title": "Target Message Index",
      "type": "integer"
    },
    "target_payload_ranges": {
      "items": {
        "$ref": "#/$defs/TargetPayloadRange"
      },
      "title": "Target Payload Ranges",
      "type": "array"
    },
    "technical_structure_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Technical Structure Sha256",
      "type": "string"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "variant_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Variant Id",
      "type": "string"
    }
  },
  "required": [
    "render_config_id",
    "episode_id",
    "variant_id",
    "technical_structure_sha256",
    "rendered_text",
    "rendered_conversation",
    "rendered_tools",
    "target_message_index",
    "target_payload_ranges",
    "truncated"
  ],
  "title": "RenderCandidate",
  "type": "object"
}
