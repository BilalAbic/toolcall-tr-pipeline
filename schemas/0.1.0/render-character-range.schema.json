{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A half-open Python Unicode code-point range in the rendered text.",
  "properties": {
    "end": {
      "exclusiveMinimum": 0,
      "title": "End",
      "type": "integer"
    },
    "start": {
      "minimum": 0,
      "title": "Start",
      "type": "integer"
    }
  },
  "required": [
    "start",
    "end"
  ],
  "title": "CharacterRange",
  "type": "object"
}
