{
  "$defs": {
    "CharacterRange": {
      "additionalProperties": false,
      "description": "A half-open Python Unicode code-point range in the rendered text.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CharacterRange",
      "type": "object"
    },
    "LossMask": {
      "additionalProperties": false,
      "description": "Target-only labels for one verified render; ``-100`` means ignore.",
      "properties": {
        "ignored_label": {
          "const": -100,
          "default": -100,
          "title": "Ignored Label",
          "type": "integer"
        },
        "input_ids": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Input Ids",
          "type": "array"
        },
        "labels": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "loss_mask_id": {
          "pattern": "^lossmask_[0-9a-f]{64}$",
          "title": "Loss Mask Id",
          "type": "string"
        },
        "render_id": {
          "pattern": "^render_[0-9a-f]{64}$",
          "title": "Render Id",
          "type": "string"
        },
        "schema_version": {
          "const": "loss-mask-0.1.0",
          "default": "loss-mask-0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_token_ranges": {
          "items": {
            "$ref": "#/$defs/TokenRange"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Target Token Ranges",
          "type": "array"
        }
      },
      "required": [
        "loss_mask_id",
        "render_id",
        "input_ids",
        "labels",
        "target_token_ranges"
      ],
      "title": "LossMask",
      "type": "object"
    },
    "RenderArtifact": {
      "additionalProperties": false,
      "description": "Verified, content-addressed rendering before labels are attached.",
      "properties": {
        "episode_id": {
          "pattern": "^ep_[0-9a-f]{64}$",
          "title": "Episode Id",
          "type": "string"
        },
        "render_config_id": {
          "pattern": "^rendercfg_[0-9a-f]{64}$",
          "title": "Render Config Id",
          "type": "string"
        },
        "render_id": {
          "pattern": "^render_[0-9a-f]{64}$",
          "title": "Render Id",
          "type": "string"
        },
        "rendered_text": {
          "title": "Rendered Text",
          "type": "string"
        },
        "rendered_text_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rendered Text Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "render-artifact-0.1.0",
          "default": "render-artifact-0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_payload_ranges": {
          "items": {
            "$ref": "#/$defs/TargetPayloadRange"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Target Payload Ranges",
          "type": "array"
        },
        "technical_structure_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Technical Structure Sha256",
          "type": "string"
        },
        "token_count": {
          "exclusiveMinimum": 0,
          "title": "Token Count",
          "type": "integer"
        },
        "variant_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "render_id",
        "render_config_id",
        "episode_id",
        "variant_id",
        "technical_structure_sha256",
        "rendered_text",
        "rendered_text_sha256",
        "target_payload_ranges",
        "token_count"
      ],
      "title": "RenderArtifact",
      "type": "object"
    },
    "TargetPayloadRange": {
      "additionalProperties": false,
      "description": "One renderer-declared span containing the final assistant payload.",
      "properties": {
        "assistant_message_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Assistant Message Sha256",
          "type": "string"
        },
        "character_range": {
          "$ref": "#/$defs/CharacterRange"
        },
        "rendered_payload_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rendered Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "character_range",
        "rendered_payload_sha256",
        "assistant_message_sha256"
      ],
      "title": "TargetPayloadRange",
      "type": "object"
    },
    "TokenRange": {
      "additionalProperties": false,
      "description": "A half-open token range paired with its exact character range.",
      "properties": {
        "character_range": {
          "$ref": "#/$defs/CharacterRange"
        },
        "end_token": {
          "exclusiveMinimum": 0,
          "title": "End Token",
          "type": "integer"
        },
        "start_token": {
          "minimum": 0,
          "title": "Start Token",
          "type": "integer"
        }
      },
      "required": [
        "start_token",
        "end_token",
        "character_range"
      ],
      "title": "TokenRange",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The bounded offline product of a renderer and a tokenizer.",
  "properties": {
    "loss_mask": {
      "$ref": "#/$defs/LossMask"
    },
    "render": {
      "$ref": "#/$defs/RenderArtifact"
    },
    "schema_version": {
      "const": "supervised-render-0.1.0",
      "default": "supervised-render-0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "render",
    "loss_mask"
  ],
  "title": "SupervisedRender",
  "type": "object"
}
