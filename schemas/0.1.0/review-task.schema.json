{
  "$defs": {
    "CanonicalQuarantineRecord": {
      "additionalProperties": false,
      "description": "A source-valid row rejected by strict canonicalization without repair.",
      "properties": {
        "diagnostic": {
          "$ref": "#/$defs/Diagnostic"
        },
        "quarantine_id": {
          "pattern": "^canonq_[0-9a-f]{64}$",
          "title": "Quarantine Id",
          "type": "string"
        },
        "raw_record_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Record Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "canonical-quarantine-0.1.0",
          "default": "canonical-quarantine-0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_line": {
          "exclusiveMinimum": 0,
          "title": "Source Line",
          "type": "integer"
        },
        "source_occurrence_id": {
          "pattern": "^occ_[0-9a-f]{64}$",
          "title": "Source Occurrence Id",
          "type": "string"
        }
      },
      "required": [
        "quarantine_id",
        "source_occurrence_id",
        "raw_record_sha256",
        "source_line",
        "diagnostic"
      ],
      "title": "CanonicalQuarantineRecord",
      "type": "object"
    },
    "ConflictCandidate": {
      "additionalProperties": false,
      "description": "A behavior pair that requires review and carries no automatic disposition.",
      "properties": {
        "automatic_drop": {
          "const": false,
          "default": false,
          "title": "Automatic Drop",
          "type": "boolean"
        },
        "call_multiset_same": {
          "title": "Call Multiset Same",
          "type": "boolean"
        },
        "comparison": {
          "enum": [
            "hard_conflict",
            "order_ambiguity_review"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "conflict_id": {
          "pattern": "^conf_[0-9a-f]{64}$",
          "title": "Conflict Id",
          "type": "string"
        },
        "left_member_episode_ids": {
          "items": {
            "pattern": "^ep_[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Left Member Episode Ids",
          "type": "array"
        },
        "left_ordered_behavior_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Left Ordered Behavior Fingerprint",
          "type": "string"
        },
        "left_owner_episode_id": {
          "pattern": "^ep_[0-9a-f]{64}$",
          "title": "Left Owner Episode Id",
          "type": "string"
        },
        "presented_context_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Presented Context Fingerprint",
          "type": "string"
        },
        "resolution": {
          "const": "unresolved",
          "default": "unresolved",
          "title": "Resolution",
          "type": "string"
        },
        "review_required": {
          "const": true,
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "right_member_episode_ids": {
          "items": {
            "pattern": "^ep_[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Right Member Episode Ids",
          "type": "array"
        },
        "right_ordered_behavior_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Right Ordered Behavior Fingerprint",
          "type": "string"
        },
        "right_owner_episode_id": {
          "pattern": "^ep_[0-9a-f]{64}$",
          "title": "Right Owner Episode Id",
          "type": "string"
        },
        "schema_version": {
          "const": "conflict-candidate-0.1.0",
          "default": "conflict-candidate-0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "comparison",
        "presented_context_fingerprint",
        "left_ordered_behavior_fingerprint",
        "right_ordered_behavior_fingerprint",
        "left_owner_episode_id",
        "right_owner_episode_id",
        "left_member_episode_ids",
        "right_member_episode_ids",
        "call_multiset_same"
      ],
      "title": "ConflictCandidate",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "diagnostic_catalog_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Diagnostic Catalog Version",
          "type": "string"
        },
        "episode_id": {
          "anyOf": [
            {
              "pattern": "^ep_[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Episode Id"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "diagnostic-0.1.0",
          "default": "diagnostic-0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Line"
        },
        "source_occurrence_id": {
          "anyOf": [
            {
              "pattern": "^occ_[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Occurrence Id"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage",
        "severity",
        "source_occurrence_id",
        "episode_id",
        "json_pointer",
        "source_line",
        "message",
        "retryable",
        "evidence_refs"
      ],
      "title": "Diagnostic",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One open human-only task derived from immutable upstream evidence.",
  "properties": {
    "action": {
      "enum": [
        "remediate_canonical_quarantine",
        "submit_conflict_adjudication"
      ],
      "title": "Action",
      "type": "string"
    },
    "audit_ids": {
      "items": {
        "pattern": "^audit_[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Audit Ids",
      "type": "array"
    },
    "canonical_quarantine": {
      "anyOf": [
        {
          "$ref": "#/$defs/CanonicalQuarantineRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "conflict_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConflictCandidate"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer_authority": {
      "const": "human",
      "default": "human",
      "title": "Reviewer Authority",
      "type": "string"
    },
    "schema_version": {
      "const": "review-task-0.1.0",
      "default": "review-task-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^reviewtask_[0-9a-f]{64}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_kind": {
      "enum": [
        "canonical_quarantine",
        "conflict_adjudication"
      ],
      "title": "Task Kind",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "task_kind",
    "action",
    "canonical_quarantine",
    "conflict_candidate",
    "audit_ids"
  ],
  "title": "ReviewTask",
  "type": "object"
}
