{
  "$defs": {
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "details": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Details",
      "type": "object"
    },
    "event_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Event Hash",
      "type": "string"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{64}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "parent_manifest_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Manifest Id"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Event Hash"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "run-event-0.1.0",
      "default": "run-event-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "timestamp_utc": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$",
      "title": "Timestamp Utc",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_hash",
    "previous_event_hash",
    "sequence",
    "timestamp_utc",
    "run_id",
    "stage",
    "event_type",
    "parent_manifest_id",
    "details"
  ],
  "title": "RunEvent",
  "type": "object"
}
