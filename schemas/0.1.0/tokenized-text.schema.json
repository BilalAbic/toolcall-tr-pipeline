{
  "$defs": {
    "CharacterRange": {
      "additionalProperties": false,
      "description": "A half-open Python Unicode code-point range in the rendered text.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CharacterRange",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Tokenizer output with one positive-width offset for every input token.\n\nOffsets use the same Python Unicode code-point coordinates as\n:class:`CharacterRange`.  Special tokens with no source-text offset are\nintentionally outside this protocol: their placement would make precise\ntarget-only supervision ambiguous.",
  "properties": {
    "offsets": {
      "items": {
        "$ref": "#/$defs/CharacterRange"
      },
      "minItems": 1,
      "title": "Offsets",
      "type": "array"
    },
    "schema_version": {
      "const": "tokenized-text-0.1.0",
      "default": "tokenized-text-0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "token_ids": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 1,
      "title": "Token Ids",
      "type": "array"
    }
  },
  "required": [
    "token_ids",
    "offsets"
  ],
  "title": "TokenizedText",
  "type": "object"
}
