{
  "$defs": {
    "ProtectedToken": {
      "additionalProperties": false,
      "description": "One occurrence-specific sentinel already substituted into a source segment.",
      "properties": {
        "occurrence": {
          "exclusiveMinimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "token": {
          "pattern": "^⟪S[1-9][0-9]*_P[1-9][0-9]*⟫$",
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token",
        "occurrence"
      ],
      "title": "ProtectedToken",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A single leaf that may be translated without reconstructing source JSON.",
  "properties": {
    "path": {
      "pattern": "^(?:/(?:[^/~]|~[01])*)*$",
      "title": "Path",
      "type": "string"
    },
    "protected_tokens": {
      "items": {
        "$ref": "#/$defs/ProtectedToken"
      },
      "title": "Protected Tokens",
      "type": "array"
    },
    "segment_id": {
      "pattern": "^seg_[0-9a-f]{64}$",
      "title": "Segment Id",
      "type": "string"
    },
    "source_text": {
      "minLength": 1,
      "title": "Source Text",
      "type": "string"
    }
  },
  "required": [
    "segment_id",
    "path",
    "source_text",
    "protected_tokens"
  ],
  "title": "TranslationSegment",
  "type": "object"
}
